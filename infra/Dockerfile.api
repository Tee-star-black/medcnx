FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json turbo.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/database/package.json packages/database/package.json
RUN npm ci
COPY apps/api apps/api
COPY packages/database packages/database
RUN npx prisma generate --schema packages/database/prisma/schema.prisma && npm run build --workspace apps/api

FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends libreoffice-writer fonts-liberation && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production LIBREOFFICE_BINARY=/usr/bin/libreoffice
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/packages/database ./packages/database
EXPOSE 4000
CMD ["node","apps/api/dist/main.js"]
