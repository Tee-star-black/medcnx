  reviewerEmployee Employee?                    @relation("PerformanceReviewReviewerEmployee", fields: [reviewerEmployeeId], references: [id], onDelete: SetNull)
  finalisedBy      User?                        @relation("FinalisedPerformanceReviews", fields: [finalisedByUserId], references: [id])
  goals            PerformanceGoal[]
  developmentPlans PerformanceDevelopmentPlan[]

  @@unique([cycleId, employeeId, reviewerUserId, reviewerType])
  @@index([organisationId, status])
  @@index([employeeId, status])
  @@index([reviewerUserId, status])
  @@index([cycleId])
  @@map("performance_reviews")
}

