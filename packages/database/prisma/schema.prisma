  reviewedProfileChanges           EmployeeProfileChangeRequest[] @relation("ProfileChangeReviewers")
  employeeNotifications            EmployeeNotification[]
  createdDocumentTemplates         DocumentTemplate[]             @relation("CreatedDocumentTemplates")
  uploadedDocumentTemplateVersions DocumentTemplateVersion[]      @relation("UploadedDocumentTemplateVersions")
  updatedOrganisationBranding      OrganisationBranding[]         @relation("UpdatedOrganisationBranding")
  ceoForOrganisations              OrganisationSignature[]        @relation("OrganisationCeo")
  updatedOrganisationSignatures    OrganisationSignature[]        @relation("UpdatedOrganisationSignature")
  generatedDocuments               GeneratedDocument[]            @relation("GeneratedDocuments")
  approvedGeneratedDocuments       GeneratedDocument[]            @relation("ApprovedGeneratedDocuments")
  publishedGeneratedDocuments      GeneratedDocument[]            @relation("PublishedGeneratedDocuments")
  generatedDocumentVersions        GeneratedDocumentVersion[]     @relation("GeneratedDocumentVersions")
