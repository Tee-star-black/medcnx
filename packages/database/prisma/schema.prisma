  updatedAt       DateTime               @updatedAt

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  template     PerformanceTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy    User                @relation("CreatedPerformanceCycles", fields: [createdByUserId], references: [id])
