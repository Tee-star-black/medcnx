generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id             String      @id @default(uuid())
  organisationId String
  actorUserId    String?
  employeeId     String?
  action         AuditAction
  entity         String
  entityId       String?
  message        String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime    @default(now())

  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([createdAt])
  @@index([employeeId])
  @@index([entity, entityId])
  @@index([organisationId])
  @@map("audit_logs")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model Department {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employees       Employee[]
  recruitmentJobs RecruitmentJob[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("departments")
}

model EmployeeDocument {
  id                String                   @id @default(uuid())
  organisationId    String
  employeeId        String
  category          EmployeeDocumentCategory @default(OTHER)
  title             String
  description       String?
  fileName          String
  originalName      String
  mimeType          String
  sizeBytes         Int
  storageKey        String
  isConfidential    Boolean                  @default(false)
  visibleToEmployee Boolean                  @default(true)
  expiryDate        DateTime?
  uploadedByUserId  String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("UploadedEmployeeDocuments", fields: [uploadedByUserId], references: [id])

  @@index([category])
  @@index([employeeId])
  @@index([expiryDate])
  @@index([organisationId])
  @@map("employee_documents")
}

model DocumentTemplate {
  id                        String                   @id @default(uuid())
  organisationId            String
  name                      String
  description               String?
  category                  DocumentTemplateCategory
  status                    DocumentTemplateStatus   @default(DRAFT)
  signatureMode             DocumentSignatureMode    @default(NONE)
  defaultEmployeeVisibility Boolean                  @default(false)
  currentVersionId          String?                  @unique
  createdByUserId           String
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  organisation   Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy      User                      @relation("CreatedDocumentTemplates", fields: [createdByUserId], references: [id])
  currentVersion DocumentTemplateVersion?  @relation("CurrentDocumentTemplateVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       DocumentTemplateVersion[] @relation("DocumentTemplateVersions")
  documents      GeneratedDocument[]

  @@unique([organisationId, name])
  @@index([organisationId, status])
  @@index([category])
  @@map("document_templates")
}

model DocumentTemplateVersion {
  id                      String   @id @default(uuid())
  organisationId          String
  templateId              String
  versionNumber           Int
  storageKey              String
  originalName            String
  mimeType                String   @default("application/vnd.openxmlformats-officedocument.wordprocessingml.document")
  sizeBytes               Int
  checksumSha256          String
  detectedPlaceholders    String[] @default([])
  unsupportedPlaceholders String[] @default([])
  isValid                 Boolean  @default(false)
  validationErrors        Json?
  uploadedByUserId        String
  createdAt               DateTime @default(now())

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  template     DocumentTemplate    @relation("DocumentTemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  currentFor   DocumentTemplate?   @relation("CurrentDocumentTemplateVersion")
  uploadedBy   User                @relation("UploadedDocumentTemplateVersions", fields: [uploadedByUserId], references: [id])
  documents    GeneratedDocument[]

  @@unique([templateId, versionNumber])
  @@index([organisationId])
  @@map("document_template_versions")
}

model OrganisationBranding {
  id                    String    @id @default(uuid())
  organisationId        String    @unique
  legalName             String?
  tradingName           String?
  registrationNumber    String?
  address               String?
  email                 String?
  phone                 String?
  defaultDocumentFooter String?
  logoStorageKey        String?
  logoMimeType          String?
  logoUpdatedAt         DateTime?
  updatedByUserId       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("UpdatedOrganisationBranding", fields: [updatedByUserId], references: [id])

  @@map("organisation_branding")
}

model OrganisationSignature {
  id              String                      @id @default(uuid())
  organisationId  String                      @unique
  ceoUserId       String?
  ceoFullName     String?
  ceoJobTitle     String?
  storageKey      String?
  mimeType        String?
  sizeBytes       Int?
  checksumSha256  String?
  status          OrganisationSignatureStatus @default(NOT_CONFIGURED)
  updatedByUserId String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  ceo          User?        @relation("OrganisationCeo", fields: [ceoUserId], references: [id])
  updatedBy    User?        @relation("UpdatedOrganisationSignature", fields: [updatedByUserId], references: [id])

  @@index([ceoUserId])
  @@map("organisation_signatures")
}

model GeneratedDocument {
  id                   String                   @id @default(uuid())
  organisationId       String
  employeeId           String?
  recipientId          String?
  templateId           String
  templateVersionId    String
  referenceNumber      String
  title                String
  category             DocumentTemplateCategory
  status               GeneratedDocumentStatus  @default(DRAFT)
  signatureMode        DocumentSignatureMode
  signatureStatus      DocumentSignatureStatus  @default(NOT_REQUIRED)
  visibleToEmployee    Boolean                  @default(false)
  withdrawnAt          DateTime?
  effectiveDate        DateTime?
  idempotencyKey       String?
  currentVersionNumber Int                      @default(1)
  generatedByUserId    String
  approvedByUserId     String?
  approvedAt           DateTime?
  publishedByUserId    String?
  publishedAt          DateTime?
  failureReason        String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  organisation    Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee        Employee?                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  recipient       DocumentRecipient?         @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  template        DocumentTemplate           @relation(fields: [templateId], references: [id])
  templateVersion DocumentTemplateVersion    @relation(fields: [templateVersionId], references: [id])
  generatedBy     User                       @relation("GeneratedDocuments", fields: [generatedByUserId], references: [id])
  approvedBy      User?                      @relation("ApprovedGeneratedDocuments", fields: [approvedByUserId], references: [id])
  publishedBy     User?                      @relation("PublishedGeneratedDocuments", fields: [publishedByUserId], references: [id])
  versions        GeneratedDocumentVersion[]
  approvals       DocumentApproval[]

  @@unique([organisationId, referenceNumber])
  @@unique([organisationId, idempotencyKey])
  @@index([organisationId, status])
  @@index([employeeId, visibleToEmployee, status])
  @@index([recipientId])
  @@index([templateId])
  @@map("generated_documents")
}

model DocumentRecipient {
  id                  String    @id @default(uuid())
  organisationId      String
  firstName           String
  lastName            String
  email               String?
  phone               String?
  idNumber            String?
  address             String?
  jobTitle            String?
  department          String?
  proposedSalary      Decimal?  @db.Decimal(12, 2)
  proposedStartDate   DateTime?
  candidateId         String?
  convertedEmployeeId String?
  createdByUserId     String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organisation      Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy         User                @relation("CreatedDocumentRecipients", fields: [createdByUserId], references: [id])
  candidate         Candidate?          @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  convertedEmployee Employee?           @relation("ConvertedDocumentRecipients", fields: [convertedEmployeeId], references: [id], onDelete: SetNull)
  documents         GeneratedDocument[]

  @@index([organisationId])
  @@index([email])
  @@index([candidateId])
  @@index([convertedEmployeeId])
  @@map("document_recipients")
}

model GeneratedDocumentVersion {
  id                  String   @id @default(uuid())
  organisationId      String
  generatedDocumentId String
  versionNumber       Int
  docxStorageKey      String?
  pdfStorageKey       String?
  docxSizeBytes       Int?
  pdfSizeBytes        Int?
  checksumSha256      String?
  mappedDataSnapshot  Json
  brandingSnapshot    Json?
  signatureInserted   Boolean  @default(false)
  createdByUserId     String
  createdAt           DateTime @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  document     GeneratedDocument @relation(fields: [generatedDocumentId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("GeneratedDocumentVersions", fields: [createdByUserId], references: [id])

  @@unique([generatedDocumentId, versionNumber])
  @@index([organisationId])
  @@map("generated_document_versions")
}

model DocumentApproval {
  id                  String                 @id @default(uuid())
  organisationId      String
  generatedDocumentId String
  requestedByUserId   String
  assignedToUserId    String
  status              DocumentApprovalStatus @default(PENDING)
  decisionNote        String?
  requestedAt         DateTime               @default(now())
  decidedAt           DateTime?

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  document     GeneratedDocument @relation(fields: [generatedDocumentId], references: [id], onDelete: Cascade)
  requestedBy  User              @relation("RequestedDocumentApprovals", fields: [requestedByUserId], references: [id])
  assignedTo   User              @relation("AssignedDocumentApprovals", fields: [assignedToUserId], references: [id])

  @@index([organisationId, status])
  @@index([assignedToUserId, status])
  @@index([generatedDocumentId])
  @@map("document_approvals")
}

model Employee {
  id                       String           @id @default(uuid())
  organisationId           String
  userId                   String?          @unique
  departmentId             String?
  managerId                String?
  employeeNumber           String
  firstName                String
  lastName                 String
  email                    String?
  personalEmail            String?
  phone                    String?
  preferredName            String?
  residentialAddress       String?
  jobTitle                 String?
  employmentType           String?
  employmentStatus         EmploymentStatus @default(ACTIVE)
  startDate                DateTime?
  endDate                  DateTime?
  idNumber                 String?
  passportNumber           String?
  dateOfBirth              DateTime?
  gender                   String?
  nationality              String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  auditLogs                   AuditLog[]
  employeeDocuments           EmployeeDocument[]
  compensationProfile         EmployeeCompensationProfile?
  payrollRunItems             PayrollRunItem[]
  payrollAuditFindings        PayrollAuditFinding[]
  department                  Department?                    @relation(fields: [departmentId], references: [id])
  organisation                Organisation                   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user                        User?                          @relation(fields: [userId], references: [id])
  leaveDocuments              LeaveDocument[]
  leaveRequests               LeaveRequest[]
  attendanceRecords           AttendanceRecord[]
  attendanceCorrections       AttendanceCorrectionRequest[]
  profileChangeRequests       EmployeeProfileChangeRequest[]
  convertedDocumentRecipients DocumentRecipient[]            @relation("ConvertedDocumentRecipients")
  generatedDocuments          GeneratedDocument[]
  manager                     Employee?                      @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports               Employee[]                     @relation("EmployeeManager")
  performanceReviews          PerformanceReview[]            @relation("PerformanceReviewSubject")
  reviewerPerformanceReviews  PerformanceReview[]            @relation("PerformanceReviewReviewerEmployee")
  performanceGoals            PerformanceGoal[]
  developmentPlans            PerformanceDevelopmentPlan[]

  @@unique([organisationId, employeeNumber])
  @@index([departmentId])
  @@index([managerId])
  @@index([email])
  @@index([organisationId])
  @@map("employees")
}

model EmployeeCompensationProfile {
  id             String @id @default(uuid())
  organisationId String
  employeeId     String @unique

  paymentFrequency String  @default("MONTHLY")
  basicSalary      Decimal @default(0) @db.Decimal(12, 2)

  autoPaye   Boolean @default(true)
  uifEnabled Boolean @default(true)

  pensionEmployee Decimal @default(0) @db.Decimal(12, 2)
  pensionEmployer Decimal @default(0) @db.Decimal(12, 2)

  medicalAidEmployee   Decimal @default(0) @db.Decimal(12, 2)
  medicalAidEmployer   Decimal @default(0) @db.Decimal(12, 2)
  medicalSchemeMembers Int     @default(0)

  taxDirectiveMode      String    @default("NONE")
  taxDirectiveReference String?
  taxDirectiveValue     Decimal?  @db.Decimal(8, 2)
  taxDirectiveValidFrom DateTime?
  taxDirectiveValidTo   DateTime?

  defaultAllowances      Decimal @default(0) @db.Decimal(12, 2)
  defaultOtherDeductions Decimal @default(0) @db.Decimal(12, 2)

  bankName          String?
  bankAccountNumber String?
  paymentReference  String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([employeeId])
  @@map("employee_compensation_profiles")
}

model PayrollRun {
  id             String           @id @default(uuid())
  organisationId String
  title          String
  periodMonth    Int
  periodYear     Int
  status         PayrollRunStatus @default(DRAFT)

  employeeCount              Int     @default(0)
  totalBasicSalary           Decimal @default(0) @db.Decimal(12, 2)
  totalOvertime              Decimal @default(0) @db.Decimal(12, 2)
  totalBonus                 Decimal @default(0) @db.Decimal(12, 2)
  totalCommission            Decimal @default(0) @db.Decimal(12, 2)
  totalAllowances            Decimal @default(0) @db.Decimal(12, 2)
  totalGrossPay              Decimal @default(0) @db.Decimal(12, 2)
  totalPaye                  Decimal @default(0) @db.Decimal(12, 2)
  totalUifEmployee           Decimal @default(0) @db.Decimal(12, 2)
  totalPensionEmployee       Decimal @default(0) @db.Decimal(12, 2)
  totalMedicalAidEmployee    Decimal @default(0) @db.Decimal(12, 2)
  totalOtherDeductions       Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions            Decimal @default(0) @db.Decimal(12, 2)
  totalNetPay                Decimal @default(0) @db.Decimal(12, 2)
  totalUifEmployer           Decimal @default(0) @db.Decimal(12, 2)
  totalSdlEmployer           Decimal @default(0) @db.Decimal(12, 2)
  totalPensionEmployer       Decimal @default(0) @db.Decimal(12, 2)
  totalMedicalAidEmployer    Decimal @default(0) @db.Decimal(12, 2)
  totalEmployerContributions Decimal @default(0) @db.Decimal(12, 2)

  notes               String?
  calculatedAt        DateTime?
  lockedAt            DateTime?
  lockedByUserId      String?
  lockReason          String?
  calculationVersion  String?
  calculationSnapshot Json?
  createdByUserId     String?
  finalisedByUserId   String?
  finalisedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?                  @relation("CreatedPayrollRuns", fields: [createdByUserId], references: [id])
  finalisedBy  User?                  @relation("FinalisedPayrollRuns", fields: [finalisedByUserId], references: [id])
  items        PayrollRunItem[]
  audit        PayrollAudit?
  timeline     PayrollTimelineEvent[]
  approvals    PayrollApproval[]

  @@unique([organisationId, periodMonth, periodYear, title])
  @@index([organisationId])
  @@index([periodMonth, periodYear])
  @@index([status])
  @@index([lockedAt])
  @@map("payroll_runs")
}

model PayrollRunItem {
  id             String @id @default(uuid())
  organisationId String
  payrollRunId   String
  employeeId     String

  periodMonth Int
  periodYear  Int

  basicSalary Decimal @default(0) @db.Decimal(12, 2)
  overtime    Decimal @default(0) @db.Decimal(12, 2)
  bonus       Decimal @default(0) @db.Decimal(12, 2)
  commission  Decimal @default(0) @db.Decimal(12, 2)
  allowances  Decimal @default(0) @db.Decimal(12, 2)
  grossPay    Decimal @default(0) @db.Decimal(12, 2)

  paye               Decimal @default(0) @db.Decimal(12, 2)
  uifEmployee        Decimal @default(0) @db.Decimal(12, 2)
  pensionEmployee    Decimal @default(0) @db.Decimal(12, 2)
  medicalAidEmployee Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions    Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions    Decimal @default(0) @db.Decimal(12, 2)
  netPay             Decimal @default(0) @db.Decimal(12, 2)

  uifEmployer        Decimal @default(0) @db.Decimal(12, 2)
  sdlEmployer        Decimal @default(0) @db.Decimal(12, 2)
  pensionEmployer    Decimal @default(0) @db.Decimal(12, 2)
  medicalAidEmployer Decimal @default(0) @db.Decimal(12, 2)
  employerTotal      Decimal @default(0) @db.Decimal(12, 2)

  payeMode                     String?
  payeTaxYear                  Int?
  payeAnnualTaxableIncome      Decimal? @db.Decimal(12, 2)
  payeAnnualTaxBeforeRebate    Decimal? @db.Decimal(12, 2)
  payeAnnualRebate             Decimal? @db.Decimal(12, 2)
  payeAnnualMedicalCredit      Decimal? @db.Decimal(12, 2)
  payeAnnualTaxAfterRebate     Decimal? @db.Decimal(12, 2)
  payeRegularTaxableIncome     Decimal? @db.Decimal(12, 2)
  payeRegularTaxableIncomeYtd  Decimal? @db.Decimal(12, 2)
  payeAnnualPaymentsYtd        Decimal? @db.Decimal(12, 2)
  payeYtdBeforeCurrent         Decimal? @db.Decimal(12, 2)
  payeCumulativeLiability      Decimal? @db.Decimal(12, 2)
  payeAnnualPaymentTax         Decimal? @db.Decimal(12, 2)
  payePeriodsWorked            Int?
  allowableRetirementDeduction Decimal? @db.Decimal(12, 2)

  payslipDocumentId   String?
  inputSnapshot       Json?
  calculationSnapshot Json?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([organisationId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@index([periodMonth, periodYear])
  @@map("payroll_run_items")
}

model PayrollAudit {
  id             String @id @default(uuid())
  organisationId String
  payrollRunId   String @unique

  healthScore Int                   @default(100)
  riskLevel   PayrollAuditRiskLevel @default(LOW)

  criticalCount Int @default(0)
  highCount     Int @default(0)
  warningCount  Int @default(0)
  infoCount     Int @default(0)

  summary      String?
  blocked      Boolean  @default(false)
  analysedAt   DateTime @default(now())
  analysedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun            @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  analysedBy   User?                 @relation("AnalysedPayrollAudits", fields: [analysedById], references: [id])
  findings     PayrollAuditFinding[]

  @@index([organisationId])
  @@index([payrollRunId])
  @@index([riskLevel])
  @@index([blocked])
  @@map("payroll_audits")
}

model PayrollAuditFinding {
  id             String  @id @default(uuid())
  organisationId String
  payrollAuditId String
  employeeId     String?

  ruleCode String
  severity PayrollAuditSeverity
  status   PayrollAuditFindingStatus @default(OPEN)

  title       String
  description String

  currentValue  Decimal? @db.Decimal(14, 2)
  previousValue Decimal? @db.Decimal(14, 2)
  varianceValue Decimal? @db.Decimal(14, 2)
  varianceRate  Decimal? @db.Decimal(8, 4)

  metadata Json?

  acknowledgedById String?
  acknowledgedAt   DateTime?

  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payrollAudit   PayrollAudit @relation(fields: [payrollAuditId], references: [id], onDelete: Cascade)
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  acknowledgedBy User?        @relation("AcknowledgedPayrollFindings", fields: [acknowledgedById], references: [id])
  resolvedBy     User?        @relation("ResolvedPayrollFindings", fields: [resolvedById], references: [id])

  @@index([organisationId])
  @@index([payrollAuditId])
  @@index([employeeId])
  @@index([severity])
  @@index([status])
  @@index([ruleCode])
  @@map("payroll_audit_findings")
}

model PayrollTimelineEvent {
  id             String  @id @default(uuid())
  organisationId String
  payrollRunId   String
  actorUserId    String?

  eventType String
  title     String
  message   String?
  metadata  Json?

  createdAt DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  actor        User?        @relation("PayrollTimelineActors", fields: [actorUserId], references: [id])

  @@index([organisationId])
  @@index([payrollRunId])
  @@index([eventType])
  @@index([createdAt])
  @@map("payroll_timeline_events")
}

model PayrollApproval {
  id             String @id @default(uuid())
  organisationId String
  payrollRunId   String

  approvalType PayrollApprovalType
  status       PayrollApprovalStatus @default(PENDING)

  requestedByUserId String?
  approverUserId    String?

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  expiresAt   DateTime?

  requestNote     String?
  decisionNote    String?
  rejectionReason String?

  summarySnapshot Json?
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation  Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payrollRun    PayrollRun            @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  requestedBy   User?                 @relation("RequestedPayrollApprovals", fields: [requestedByUserId], references: [id])
  approver      User?                 @relation("ReviewedPayrollApprovals", fields: [approverUserId], references: [id])
  otpChallenges PayrollOtpChallenge[]

  @@index([organisationId])
  @@index([payrollRunId])
  @@index([approvalType])
  @@index([status])
  @@index([approverUserId])
  @@index([requestedAt])
  @@map("payroll_approvals")
}

model PayrollOtpChallenge {
  id                String @id @default(uuid())
  organisationId    String
  payrollApprovalId String
  userId            String

  purpose PayrollOtpPurpose
  status  PayrollOtpStatus  @default(PENDING)

  codeHash String

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  expiresAt   DateTime
  verifiedAt  DateTime?
  cancelledAt DateTime?

  requestedIpAddress String?
  verifiedIpAddress  String?
  userAgent          String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation    Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payrollApproval PayrollApproval @relation(fields: [payrollApprovalId], references: [id], onDelete: Cascade)
  user            User            @relation("PayrollOtpChallengeUsers", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([payrollApprovalId])
  @@index([userId])
  @@index([purpose])
  @@index([status])
  @@index([expiresAt])
  @@map("payroll_otp_challenges")
}

model RecruitmentJob {
