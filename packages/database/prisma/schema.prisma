model PerformanceReview {
  id                     String                  @id @default(uuid())
  organisationId         String
  cycleId                String
  employeeId             String
  reviewerUserId         String
  reviewerEmployeeId     String?
  reviewerType           PerformanceReviewerType
  status                 PerformanceReviewStatus @default(ASSIGNED)
  confidential           Boolean                 @default(false)
  answers                Json?
  overallScore           Decimal?                @db.Decimal(5, 2)
  strengths              String?
  developmentAreas       String?
  managerSummary         String?
  finalOutcome           String?
  submittedAt            DateTime?
  finalisedByUserId      String?
  finalisedAt            DateTime?
  employeeAcknowledgedAt DateTime?
  employeeComments       String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  organisation     Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  cycle            PerformanceCycle             @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee         Employee                     @relation("PerformanceReviewSubject", fields: [employeeId], references: [id], onDelete: Cascade)
