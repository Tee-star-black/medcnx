NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# Comma-separated additional trusted web origins.
FRONTEND_URLS=http://localhost:3000
# Enable only behind a trusted reverse proxy such as GCP HTTPS Load Balancer.
TRUST_PROXY=false

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_32_character_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Payroll executive approval security
PAYROLL_OTP_SECRET=replace_with_a_long_random_secret
PAYROLL_OTP_EXPIRY_MINUTES=10
PAYROLL_OTP_RESEND_SECONDS=60

# Payroll approval email delivery
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=payroll@example.com
MAIL_PASSWORD=replace_me
MAIL_FROM_NAME=MedCNX Payroll
MAIL_FROM_EMAIL=payroll@example.com

# Document Generation V2 private storage
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_LOCAL_ROOT=./private-storage
# Set both values in Cloud Run to use a private Google Cloud Storage bucket.
# DOCUMENT_STORAGE_DRIVER=gcs
# DOCUMENT_STORAGE_GCS_BUCKET=your-private-medcnx-documents-bucket

# Backend DOCX-to-PDF conversion
LIBREOFFICE_BINARY=libreoffice
DOCUMENT_PDF_TIMEOUT_MS=45000
